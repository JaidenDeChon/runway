# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Supabase local state. `supabase link` writes the remote project ref into
# supabase/.temp/ — keeping it out of git is what stops a local checkout from
# silently pointing at the hosted project.
supabase/.temp/
supabase/.branches/

# Playwright output. Reports and traces contain rendered page content — which
# for this app means balances — so they are build artifacts, never commits.
/test-results
/playwright-report
/blob-report
/playwright/.cache

# `supabase start` output is captured to this file in CI so its key banner
# never reaches the log. It holds those keys; never commit it.
supabase-start.log

# Agent run state. `.claude/agents/gh-board-runner.md` checkpoints the board
# queue, the current task's phase, and each task's Opus plan here so a rate
# limit costs a resume rather than a re-plan. Run state, not source — the
# durable copy lives on the issues and the project board.
.claude/runway-runner/

# Agent worktrees. Each carries its own `biome.json`, which `bun run lint`
# (`biome ci .`) refuses to coexist with — "found a nested root configuration"
# — failing the whole repo's lint on a scratch directory. Biome reads this file
# (`vcs.useIgnoreFile`), so ignoring them here fixes that and keeps a worktree
# from ever being committed by accident.
.claude/worktrees/
