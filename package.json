{
  "name": "runway",
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@supabase/supabase-js": "2.112.3",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "4.5.2",
    "reka-ui": "2.10.3",
    "shadcn-vue": "2.8.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.domain.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "ui:add": "shadcn-vue add",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > shared/supabase/database.types.ts",
    "test:rls": "vitest run --project rls"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22",
    "fast-check": "4.9.0",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.0"
  }
}
