{
  // Nuxt's generated app tsconfig includes `tests/nuxt/**/*` only, so the
  // live-database RLS suite in `tests/rls/` would otherwise never be
  // typechecked — vitest strips types without checking them. Strict mode is
  // non-negotiable for a money app, and that has to include the tests that
  // prove the money is protected.
  //
  // `domain/**/*.test.ts` is here for the same reason and was missing for the
  // same reason: tsconfig.domain.json deliberately *excludes* the tests so the
  // engine compiles with `"types": []`, which left them checked by nothing at
  // all. The engine's tests are where its invariants are written down; they get
  // the same strictness the engine does.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Mirrors the aliases Nuxt provides at runtime and the ones
    // vitest.config.ts declares for this project. `~~` / `@@` are the project
    // root, which is how a test reaches `domain/` — see seed-fidelity.test.ts.
    "paths": {
      "#shared/*": ["./shared/*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"]
    }
  },
  "include": ["tests/**/*.ts", "domain/**/*.test.ts"]
}
